{
  "name": "naturi-pool-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Bunch Outdoor Services — Naturi Pool Studio: design tool for free-form beach-entry sand pools",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=smoke",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.5",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@react-three/postprocessing": "2.19.1",
    "idb-keyval": "6.2.1",
    "immer": "10.1.1",
    "postprocessing": "6.37.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.170.0",
    "zod": "4.6.7",
    "zundo": "2.3.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.18",
    "fake-indexeddb": "6.0.0",
    "globals": "15.14.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.47.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
